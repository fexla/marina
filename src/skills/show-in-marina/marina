#!/bin/bash
#
# @file marina
# @purpose Platform-dispatching entry point for the show-in-marina skill. An
#   AI agent (or a human) invokes THIS file as `marina <command> ...`; this
#   wrapper selects the platform-appropriate client implementation and execs
#   it, forwarding all arguments verbatim and letting the child's exit code
#   propagate through `exec`.
#
# @why two implementations exist:
#   The skill ships TWO clients of the SAME HTTP contract
#   (src/main/file-panel-service.ts):
#     - marina.ps1  -- the Windows client. Uses PowerShell (ships with every
#                      Windows install) so the skill needs NO extra runtime.
#     - marina.sh   -- the POSIX client (bash + curl). Uses only the
#                      universally-present Linux/macOS toolkit so the skill
#                      needs NO extra runtime there either (no jq/python/node).
#   This dispatcher picks one based on what is available on the host, so a
#   single `marina` entry point works everywhere the skill is installed.
#
# @zero-external-tooling (hard requirement):
#   This script MUST run with ONLY bash builtins until it execs a client.
#   Real-world trap (repro'd 2026-08-16): AI tools (Claude Code etc.) inside
#   a Marina terminal spawn Git Bash RAW -- no login/profile -- so the MSYS
#   PATH is just the translated Windows PATH. Marina's PTY PATH is refreshed
#   from the registry, which contains Git\cmd but NOT Git\usr\bin. In that
#   environment:
#     - `#!/usr/bin/env bash` shebang dies: env cannot FIND bash on PATH
#       ("/usr/bin/env: 'bash': No such file or directory").
#     - dirname / uname / any /usr/bin tool: "command not found".
#   Consequences for this file:
#     - Shebang is `#!/bin/bash`: /bin is a guaranteed MSYS mount (and the
#       standard location on macOS and mainstream Linux), and it bypasses
#       the PATH search that `env` does. (NixOS-style hosts without /bin/bash
#       are out of scope; they can still run `bash marina ...` explicitly.)
#     - SCRIPT_DIR uses bash parameter expansion instead of dirname(1).
#     - cygpath is OPTIONAL (guarded by command -v, with a POSIX-path
#       fallback that powershell.exe accepts).
#   Guarded by shipped-scripts-ascii.test.ts (shebang + no $(dirname/...)).
#
# @dispatch rule:
#     powershell.exe available (Windows, or a Linux box with PowerShell Core
#       installed AND on PATH as `powershell.exe`)  ->  marina.ps1
#     otherwise (typical Linux / macOS)             ->  marina.sh
#   Detecting powershell.exe (rather than process.platform) keeps this script
#   free of any platform-specific uname/OS probing and naturally routes a
#   Git Bash / MSYS shell on Windows to the PowerShell path (the case this
#   wrapper was originally written for -- see the Windows note below).
#
# @ascii-only (ENC-1): matches the sibling marina.cmd / marina.ps1 / marina.sh
#   rule. English only, no BOM. Guarded by shipped-scripts-ascii.test.ts.
#
# @corresponding:
#   src/skills/show-in-marina/marina.sh    POSIX client (Linux / macOS)
#   src/skills/show-in-marina/marina.ps1   Windows client (PowerShell)
#   src/skills/show-in-marina/marina.cmd   Windows cmd/PowerShell launcher
#   src/skills/show-in-marina/SKILL.md     when to use which entry point

# Locate the directory of THIS script (side by side with marina.ps1 and
# marina.sh). BUILTIN-ONLY on purpose (see @zero-external-tooling above):
# dirname(1) is NOT available when AI tools spawn Git Bash raw inside a
# Marina terminal. ${BASH_SOURCE[0]} gives the path this script was invoked
# from, so it works regardless of the agent's cwd or PATH. (It does NOT
# resolve symlinks; SKILL.md requires invoking the installed file directly,
# so symlink invocation is not a supported path.)
case "${BASH_SOURCE[0]}" in
  */*)
    SCRIPT_PARENT="${BASH_SOURCE[0]%/*}"
    ;;
  *\\*)
    # Windows-style path with backslashes (e.g. `bash D:\skills\marina ping`):
    # no forward slash, so the case above missed it. Strip after the last
    # backslash instead; MSYS `cd` accepts Windows-style paths natively.
    SCRIPT_PARENT="${BASH_SOURCE[0]%\\*}"
    ;;
  *)
    # Invoked as a bare name (e.g. `bash marina` from the skill directory):
    # no separator to strip, the script lives in the current directory.
    SCRIPT_PARENT="."
    ;;
esac
SCRIPT_DIR="$(cd -- "${SCRIPT_PARENT}" && pwd)"

# -- Windows path: PowerShell client (marina.ps1) -------------------------
#
# Why this exists historically (the cmd /c trap, kept for the Windows branch):
#   When an AI agent runs `cmd /c "marina.cmd ..." ` inside a bash tool on
#   Windows, MSYS / Git Bash applies POSIX-to-Windows path conversion to the
#   arguments BEFORE handing them to cmd.exe. The `/c` flag is NOT a path,
#   but MSYS rewrites it to `C:/` anyway. cmd.exe therefore never receives
#   the `/c` flag and, instead of running marina.cmd and exiting, it starts
#   an INTERACTIVE cmd session that hangs and -- critically -- returns exit
#   0, so the agent wrongly believes the command succeeded.
#     cmd /c "marina.cmd" foobar   -> interactive cmd, exit 0   (WRONG)
#     ./marina.cmd foobar          -> exit 2                    (correct)
#     powershell -File marina.ps1  -> exit 2                    (correct)
#   The robust fix is to bypass cmd.exe entirely and call the real logic
#   (marina.ps1) via powershell.exe -File directly.

# Find powershell.exe. On Windows it is normally on PATH; if not, fall back
# to the well-known System32 location.
PS_BIN=""
if command -v powershell.exe >/dev/null 2>&1; then
  PS_BIN="powershell.exe"
elif [ -x "/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe" ]; then
  PS_BIN="/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe"
fi

if [ -n "${PS_BIN}" ]; then
  # -- Windows: exec marina.ps1 via PowerShell --
  PS1_PATH="${SCRIPT_DIR}/marina.ps1"
  if [ ! -f "${PS1_PATH}" ]; then
    echo "marina: marina.ps1 not found next to ${BASH_SOURCE[0]} (looked: ${PS1_PATH})" >&2
    exit 127
  fi
  # Convert the .ps1 path to a Windows-style path before handing it to
  # powershell.exe. Under Git Bash / MSYS the MSYS runtime would convert a
  # POSIX path argument for us, but that is a runtime feature, not guaranteed
  # on every bash port. cygpath is the explicit, portable conversion; if it
  # is missing (raw MSYS without /usr/bin on PATH -- see
  # @zero-external-tooling) we fall back to the forward-slash path, which
  # powershell.exe -File accepts natively.
  if command -v cygpath >/dev/null 2>&1; then
    PS1_PATH_WIN="$(cygpath -w "${PS1_PATH}")"
  else
    PS1_PATH_WIN="${PS1_PATH}"
  fi
  # -NoProfile: clean, fast startup (skip the user PS profile).
  # -ExecutionPolicy Bypass: run the .ps1 regardless of the machine default
  #   policy (agents cannot be expected to run Set-ExecutionPolicy first).
  # -File: pass the script path; "$@" forwards every remaining arg verbatim.
  # `exec` replaces this shell with powershell so the child's exit code is the
  # exit code the caller sees -- no wrapper-level masking.
  exec "${PS_BIN}" -NoProfile -ExecutionPolicy Bypass -File "${PS1_PATH_WIN}" "$@"
fi

# -- POSIX path: native client (marina.sh) for Linux / macOS --------------
#
# No powershell.exe -> we are on a non-Windows host (typical Linux / macOS).
# Use the native bash+curl client so the skill works with ZERO extra runtime
# (no PowerShell, no python, no node, no jq). marina.sh implements the exact
# same HTTP contract and exit codes as marina.ps1.
SH_PATH="${SCRIPT_DIR}/marina.sh"
if [ ! -f "${SH_PATH}" ]; then
  echo "marina: marina.sh not found next to ${BASH_SOURCE[0]} (looked: ${SH_PATH})" >&2
  echo "marina: (no powershell.exe on this host either, so neither client is available)" >&2
  exit 127
fi
# Prefer to exec marina.sh directly if it has the executable bit (the common
# case: the repo ships it +x, and skill-installer's fs.cp preserves mode on
# Linux). If the bit is missing (e.g. a filesystem that dropped it), fall
# back to invoking it through bash so the skill still works. Either way `exec`
# propagates the child's exit code unchanged.
if [ -x "${SH_PATH}" ]; then
  exec "${SH_PATH}" "$@"
else
  exec bash "${SH_PATH}" "$@"
fi
